{
  // Tailwind für die Klassen im JSX; oxc für die Prüfregeln aus
  // .oxlintrc.json und frontend/.oxlintrc.json (ESLint benutzt der Almanach
  // nicht – `npm run lint` ruft oxlint).
  //
  // Dazu drei, die keine Regel prüfen, aber beim Arbeiten an diesem Projekt
  // helfen: SQLite Viewer für backend/data/manager.sqlite3 direkt im
  // Editor, Docker für Dockerfile und docker-compose.yml (Weg A der
  // Einrichtung), GitLens für die Geschichte des Codes (siehe das Kapitel
  // „Wie der Almanach entstand“ im Handbuch).
  "recommendations": [
    "bradlc.vscode-tailwindcss",
    "oxc.oxc-vscode",
    "qwtel.sqlite-viewer",
    "ms-azuretools.vscode-docker",
    "eamodio.gitlens"
  ]
}
