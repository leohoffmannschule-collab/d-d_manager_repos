# Der Almanach läuft ohne jede Einstellung hier – diese Datei ist freiwillig.
#
# Sie nach ".env" kopieren, wenn du eine der folgenden Möglichkeiten nutzen
# willst; sonst kann sie liegenbleiben.
#
#   cp .env.example .env
#
# Gelesen wird sie auf beiden Wegen: `docker compose` schöpft daraus, und
# `npm start` liest sie beim Start selbst ein. Ins Git gehört sie nicht: Was
# hier unten steht, ist deine Einrichtung und geht niemanden sonst etwas an.

# --- Feste Adresse für die Runde (freiwillig) ---------------------------------
# Ohne diese Zeilen leiht sich der Schnelltunnel bei jedem Start eine neue
# Adresse, und die Runde bekommt vor jedem Spielabend eine andere geschickt.
# Mit ihnen heißt der Almanach für alle immer gleich.
#
# Die Adresse, die deine Runde eintippt. Nur der nackte Name, ohne https://
# und ohne Schrägstrich am Ende.
DOMAENE=www.deinemudda.fun

# Der Vorposten, bei dem sich dieser Rechner meldet – dorthin zeigt die Domain.
# Eingerichtet wird er einmal mit scripts/vorposten.sh; danach baut
# `npm run tunnel` die Leitung dorthin statt eines Schnelltunnels.
# Schritt für Schritt: docs/EINRICHTUNG.md, Schritt 6.5.
TUNNEL_ZIEL=tunnel@www.deinemudda.fun

# Nur nötig, wenn der Almanach auf dem Vorposten an einem anderen Port hängen
# soll als hier (Vorgabe: derselbe wie PORT).
#TUNNEL_FERNPORT=3001

# --- Erzählender Rückblick in der Chronik (freiwillig) ------------------------
# Adresse einer OpenAI-kompatiblen Schnittstelle. Örtlich z. B.
# http://localhost:8080/v1/chat/completions für llama.cpp oder Ollama; sonst
# die von OpenAI oder Anthropic. Ohne diese Zeile bleibt der Knopf verborgen.
CHRONIK_KI_URL=
CHRONIK_KI_MODELL=
CHRONIK_KI_SCHLUESSEL=
