{
  "name": "abenteuer-almanach",
  "version": "1.0.0",
  "description": "Selbst gehosteter Pen & Paper Charaktermanager (D&D 5e und andere Systeme)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n Server,Oberflaeche -c yellow,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend && node scripts/copy-frontend.mjs",
    "start": "node scripts/start.mjs",
    "pruefen": "node scripts/start.mjs --pruefen",
    "serve": "npm start --prefix backend",
    "adresse": "node scripts/adresse.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "sicherung": "node backend/scripts/sicherung.mjs",
    "vertrag": "node scripts/vertrag.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
